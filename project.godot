; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CrackNet"
config/description="Co-op netcode for Godot C#: distributed authority"
run/main_scene="res://examples/playground/playground.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

NetworkCommandServer="*res://addons/cracknet/Servers/NetworkCommandServer.cs"
NetworkTime="*res://addons/cracknet/NetworkTime.cs"
NetworkTimeSynchronizer="*res://addons/cracknet/NetworkTimeSynchronizer.cs"
NetworkEvents="*res://addons/cracknet/NetworkEvents.cs"
NetworkIdentityServer="*res://addons/cracknet/Servers/NetworkIdentityServer.cs"
NetworkObjectServer="*res://addons/cracknet/Servers/NetworkObjectServer.cs"
WindowTiler="*res://addons/cracknet/Extras/WindowTiler.cs"
NetworkSimulator="*res://addons/cracknet/Extras/NetworkSimulator.cs"
MCPGameBridge="res://addons/godot_mcp/game_bridge/mcp_game_bridge.gd"

[cracknet]

general/clear_settings=false
extras/auto_tile_windows=true
extras/screen=1
extras/borderless=true
autoconnect/enabled=true
autoconnect/simulated_latency_ms=150.0
autoconnect/simulated_packet_loss_chance=0.05
autoconnect/simulated_jitter_ms=100.0
autoconnect/simulated_burst_loss_ms=200.0
autoconnect/simulated_burst_interval_seconds=5.0

[dotnet]

project/assembly_name="CrackNet"

[editor_plugins]

enabled=PackedStringArray("res://addons/cracknet/plugin.cfg", "res://addons/godot_mcp/plugin.cfg")

[godot_mcp]

bind_mode=0
custom_bind_ip=""
port_override_enabled=false
port_override=6550

[physics]

3d/physics_engine="Rapier3D"
rapier/solver/normalized_max_corrective_velocity=2.0

[playground]

playtest_log=false

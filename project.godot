; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="netfox-net"
config/description="Native C# port of netfox: rollback netcode for Godot"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

NetworkCommandServer="*res://addons/netfox-net/Servers/NetworkCommandServer.cs"
NetworkTime="*res://addons/netfox-net/NetworkTime.cs"
NetworkTimeSynchronizer="*res://addons/netfox-net/NetworkTimeSynchronizer.cs"
NetworkEvents="*res://addons/netfox-net/NetworkEvents.cs"
NetworkIdentityServer="*res://addons/netfox-net/Servers/NetworkIdentityServer.cs"
RollbackLivenessServer="*res://addons/netfox-net/Servers/RollbackLivenessServer.cs"
NetworkHistoryServer="*res://addons/netfox-net/Servers/NetworkHistoryServer.cs"
RollbackSimulationServer="*res://addons/netfox-net/Servers/RollbackSimulationServer.cs"
NetworkSynchronizationServer="*res://addons/netfox-net/Servers/NetworkSynchronizationServer.cs"
NetworkRollback="*res://addons/netfox-net/Rollback/NetworkRollback.cs"
NetworkPerformance="*res://addons/netfox-net/NetworkPerformance.cs"
InterpolationServer="*res://addons/netfox-net/Servers/InterpolationServer.cs"
WindowTiler="*res://addons/netfox-net/Extras/WindowTiler.cs"
NetworkSimulator="*res://addons/netfox-net/Extras/NetworkSimulator.cs"

[dotnet]

project/assembly_name="Netfox"

[editor_plugins]

enabled=PackedStringArray("res://addons/netfox-net/plugin.cfg")

[netfox]

general/clear_settings=false
events/enabled=true

[physics]

3d/physics_engine="Rapier3D"

<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CrackNet</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Feeds docs/generate-api.py. CS1591 off: the summaries that matter are written, not every member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="CrackNet.Core/**;CrackNet.Core.Tests/**;CrackNet.SourceGenerators/**;netfox/**;.tools/**;.godot/**" />
    <None Remove="CrackNet.Core/**;CrackNet.Core.Tests/**;CrackNet.SourceGenerators/**;netfox/**;.tools/**;.godot/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="CrackNet.Core/CrackNet.Core.csproj" />
    <!-- The generator runs in the compiler, so it is referenced as an analyzer and its assembly is not linked -->
    <ProjectReference Include="CrackNet.SourceGenerators/CrackNet.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The spawn generator reads scenes to find each spawnable class's scene and fail the build without one -->
    <AdditionalFiles Include="**/*.tscn" Exclude=".godot/**;.tools/**;netfox/**" />
  </ItemGroup>
</Project>
